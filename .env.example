# ==========================================================================
# ClearMind 本地凭证 / 环境变量模板
# ==========================================================================
# 用法：
#   1. cp .env.example .env
#   2. 编辑 .env 填入真实 token
#   3. 加载到当前 shell（三选一，详见 docs/DEMO_DEPLOY.md "Token 持久化"章节）：
#      a) direnv allow（推荐，进入目录自动加载）
#      b) set -a && source .env && set +a（手工，每次跑前一次）
#      c) bash scripts/with_env.sh <你的命令>（wrapper，不改 zshrc）
#
# .env 已在 .gitignore，不会被 commit。绝不要把真实 token 写进 .env.example。
# ==========================================================================

# ModelScope access token（来自 https://www.modelscope.cn/my/myaccesstoken）
# push_to_modelscope.py 会读这个变量
MODELSCOPE_API_TOKEN=ms_replace_me_with_real_token

# HuggingFace token（可选；推荐用 `hf auth login` 持久化到 ~/.cache/huggingface/token，
# 这样所有 huggingface_hub / transformers 调用自动 fallback 读，不需要在 .env 重复配置）
# HF_TOKEN=hf_replace_me_with_real_token
